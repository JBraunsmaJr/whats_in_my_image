{
  "name": "main: protection and required checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Lint and format"
          },
          {
            "context": "Test (Python 3.9)"
          },
          {
            "context": "Test (Python 3.10)"
          },
          {
            "context": "Test (Python 3.11)"
          },
          {
            "context": "Test (Python 3.12)"
          },
          {
            "context": "Test (Python 3.13)"
          },
          {
            "context": "Test (Python 3.14)"
          },
          {
            "context": "Build distribution"
          },
          {
            "context": "Scanner sidecar (container engine)"
          },
          {
            "context": "CodeQL (SAST) (python)"
          },
          {
            "context": "CodeQL (SAST) (actions)"
          },
          {
            "context": "Bandit (Python SAST)"
          },
          {
            "context": "Trivy (dependencies, secrets, misconfiguration)"
          },
          {
            "context": "Gitleaks (secrets in full git history)"
          },
          {
            "context": "Workflow security (actionlint, zizmor)"
          },
          {
            "context": "Dependency review"
          }
        ]
      }
    }
  ]
}
